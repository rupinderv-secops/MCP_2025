rule linux_ssh_brute_force_and_accepted_root_login {
  meta:
    rule_name = "Linux NIX_SYSTEM SSH Brute Force Followed by Root Login"
    description = "Detects multiple failed SSH logins followed by an Accepted password login on root across NIX_SYSTEM and EDR telemetry, accounting for NIX_SYSTEM parser v32.0 omitting security_result.action=ALLOW and placing victim hostname in target.hostname."
    severity = "Critical"
    tactic = "Credential Access, Initial Access"
    technique = "T1110.001, T1078.003"

  events:
    $fail.metadata.event_type = "USER_LOGIN"
    $fail.security_result.action = "BLOCK"
    $fail.target.user.userid = "root"
    $fail.target.hostname = $victim_host
    $victim_host != ""

    $success.metadata.event_type = "USER_LOGIN"
    ($success.security_result.action = "ALLOW" or $success.security_result.description = "Accepted password")
    $success.target.user.userid = "root"
    $success.target.hostname = $victim_host

    $fail.metadata.event_timestamp.seconds <= $success.metadata.event_timestamp.seconds

  match:
    $victim_host over 15m

  outcome:
    $failed_login_count = count_distinct($fail.metadata.id)
    $failed_source_ips = array_distinct($fail.principal.ip)
    $success_source_ips = array_distinct($success.principal.ip)
    $victim_hostname = array_distinct($fail.target.hostname)

  condition:
    #fail >= 5 and $success
}
