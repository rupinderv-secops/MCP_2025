rule clickfix_delivery_and_payload_cradle_detection {
  meta:
    author = "Google SecOps Detection Engineering"
    description = "Detects ClickFix social engineering execution cradles delivering Infostealers, RATs, Loaders, and Ransomware across Windows, macOS, and Linux."
    severity = "HIGH"
    priority = "HIGH"
    platform = "WINDOWS, MACOS, LINUX"
    mitre_attack_tactic = "Execution, Defense Evasion, Command and Control"
    mitre_attack_technique = "T1204.002, T1059.001, T1059.004, T1218.005, T1105"
    mitre_attack_url = "https://attack.mitre.org/techniques/T1204/002/"

  events:
    $process.metadata.event_type = "PROCESS_LAUNCH"
    (
      // --- 1. Windows: PowerShell / CMD / MSHTA / Certutil Cradles ---
      (
        re.regex($process.target.process.file.full_path, `(?i)(\\powershell\.exe|\\pwsh\.exe|\\cmd\.exe|\\mshta\.exe|\\certutil\.exe|\\curl\.exe)`) and
        (
          // Obfuscated or piped download cradles
          re.regex($process.target.process.command_line, `(?i)(iex\s*\(|invoke-expression|invoke-webrequest|irm\s+http|downloadstring|downloadfile)`) or
          re.regex($process.target.process.command_line, `(?i)(-enc(odedcommand)?\s+[a-z0-9+/=]{20,})`) or
          re.regex($process.target.process.command_line, `(?i)(mshta\s+https?://)`) or
          re.regex($process.target.process.command_line, `(?i)(certutil(\.exe)?\s+(-urlcache|-split)\s+(-f|-split)\s+https?://)`)
        )
      )
      or
      // --- 2. macOS: AppleScript / Shell Execution (AMOS and Stealers) ---
      (
        re.regex($process.target.process.file.full_path, `(?i)(\/osascript|\/bash|\/zsh|\/sh|\/curl)`) and
        (
          re.regex($process.target.process.command_line, `(?i)(osascript\s+-e\s+.*do\s+shell\s+script.*curl)`) or
          re.regex($process.target.process.command_line, `(?i)(curl\s+-[a-z]*f[a-z]*\s+https?://.*\|\s*(sh|bash|zsh))`)
        )
      )
      or
      // --- 3. Linux: Piped Remote Execution ---
      (
        re.regex($process.target.process.file.full_path, `(?i)(\/curl|\/wget|\/bash|\/sh)`) and
        (
          re.regex($process.target.process.command_line, `(?i)(curl\s+-[fsSLk]+\s+https?://.*\|\s*(sh|bash))`) or
          re.regex($process.target.process.command_line, `(?i)(wget\s+-[qO\-]+\s+https?://.*\|\s*(sh|bash))`)
        )
      )
    )

    // Correlation entities
    $hostname = $process.principal.hostname
    $user = $process.principal.user.userid

  match:
    $hostname, $user over 5m

  outcome:
    $risk_score = max(85)
    //$mitre_tactics = array_distinct("Execution", "Defense Evasion", "Command and Control")
   // $mitre_techniques = array_distinct("T1204.002", "T1059.001", "T1059.004", "T1218.005", "T1105")
    $principal_host = array_distinct($process.principal.hostname)
    $principal_user = array_distinct($process.principal.user.userid)
    $executed_command = array_distinct($process.target.process.command_line)
    $process_path = array_distinct($process.target.process.file.full_path)
    $parent_process = array_distinct($process.src.process.file.full_path)

  condition:
    $process
}
